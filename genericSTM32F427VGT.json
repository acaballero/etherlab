{
  "build": {
    "core": "stm32",
    "cpu": "cortex-m4",
    "extra_flags": "-DSTM32F4 -DSTM32F427xC",
    "f_cpu": "168000000L",
    "ldscript": "stm32f42xx.ld",
    "mcu": "stm32f427vgt"
  },
  "connectivity": [
    "can"
  ],
  "debug": {
    "jlink_device": "STM32F427VGT",
