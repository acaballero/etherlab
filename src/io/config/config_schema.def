CFG_ENUM("fft.waterfall_mode", fft_waterfall_mode, fft.waterfall_mode);

CFG_I16("fft.DCOffset_I", fft_DCOffset_I, fft.DCOffset_I);
CFG_I16("fft.DCOffset_Q", fft_DCOffset_Q, fft.DCOffset_Q);
