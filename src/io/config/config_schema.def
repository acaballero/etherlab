// X-macro configuration schema.
//
// This file is intentionally included multiple times with different macro
// definitions to generate save/load/journal code.
//
// Each entry provides:
//   - KEY: string key (without trailing '=')
//   - ID:  identifier used for journal baseline storage (flattened)
//   - MEMBER: member path within st_config (may be nested)
//
// Special markers:
// - CFG_VERSION(ID) is for snapshot-only version line handling.
// - CFG_VFO_ARRAY(ID) is for snapshot/journal VFO array fields.
// - CFG_FFT_IQ_BLOBS(ID) is for snapshot-only large binary fields.

CFG_VERSION(version);

CFG_BOOL("debug", debug, debug);
CFG_U8("power_ctrl", power_ctrl, power_ctrl);

CFG_ENUM("filter", filter, filter);
CFG_ENUM("if_filter", if_filter, if_filter);
CFG_ENUM("frontend_path", frontend_path, frontend_path);
CFG_ENUM("modulation", modulation, modulation);
CFG_ENUM("mode", mode, mode);
CFG_ENUM("band", band, band);

CFG_BOOL("hpa_enabled", hpa_enabled, hpa_enabled);
CFG_U8("max_power_dbm", max_power_dbm, max_power_dbm);
CFG_ENUM("lo_injection", lo_injection, lo_injection);
CFG_U8("power_save_period_seconds", power_save_period_seconds, power_save_period_seconds);

CFG_U32("f_1st_if", f_1st_if, f_1st_if);
CFG_U32("f_if_fm_tx", f_if_fm_tx, f_if_fm_tx);

CFG_U8("vfo_ix", vfo_ix, vfo_ix);
CFG_VFO_ARRAY(vfo);

CFG_BOOL("memory_mode", memory_mode, memory_mode);
CFG_U32_L("f_carrier", f_carrier, f_carrier);
CFG_U32_L("f_step", f_step, f_step);
CFG_U32_L("f_max", f_max, f_max);
CFG_U32_L("f_min", f_min, f_min);

CFG_U32("repeater_offset", repeater_offset, repeater_offset);
CFG_ENUM("repeater_mode", repeater_mode, repeater_mode);

// FFT scalars
