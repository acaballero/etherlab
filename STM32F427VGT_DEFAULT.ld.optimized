/*
 * Optimized linker script for STM32F427 - HAL + lib/ + src/ structure
 * Reduces block update churn by grouping stable vs volatile code
 */

/* Entry Point */
ENTRY(Reset_Handler)

/* Highest address of the user mode stack */ 
_estack = 0x20030000;    /* end of RAM */
/* Generate a link error if heap and stack don't fit into RAM */
_Min_Heap_Size = 0x1FFF;      /* required amount of heap  */
_Min_Stack_Size = 0x1FFF;     /* required amount of stack */

/* Specify the memory areas */
MEMORY
{
    RAM (xrw)      : ORIGIN = 0x20000000, LENGTH = 196K
    FLASH (rx)      : ORIGIN = 0x8000000, LENGTH = 1024K
    CCMRAM (rw)     : ORIGIN = 0x10000000, LENGTH = 64K
}

/* Define output sections */
SECTIONS
{
  /* The startup code goes first into FLASH */
  .isr_vector :
  {
    . = ALIGN(4);
    KEEP(*(.isr_vector)) /* Startup code */
    . = ALIGN(4);
  } >FLASH

  /* Group stable code that rarely changes */
  .text.stable :
  {
    . = ALIGN(4);
    
    /* System startup and HAL - very stable */
    *system_stm32f4xx.o(.text .text.*)
    *FrameworkCMSISDevice*(.text .text.*)
    *FrameworkHALDriver*(.text .text.*)
    *stm32f4xx_hal*.o(.text .text.*)
    *stm32f4xx_ll*.o(.text .text.*)
    *libFrameworkCMSISDevice.a:*(.text .text.*)
    
    /* Your lib/ folders - these are the lib### directories */
    *lib4b7*(.text .text.*)  /* InputPin */
    *lib695*(.text .text.*)  /* CDC */
    *lib9ca*(.text .text.*)  /* FatFs */
    *libaee*(.text .text.*)  /* I2CBitBang */
    *lib*(.text .text.*)     /* All other lib### folders */
    
    /* Version info - rarely changes */
    *version.o(.text .text.*)
    
    . = ALIGN(4);
  } >FLASH

  /* Group your application code that changes frequently */
  .text.application :
  {
    . = ALIGN(4);
    
    /* Main application entry point */
    *main.o(.text .text.*)
    
    /* All your src/ files - these change frequently */
    *agc.o(.text .text.*)
    *battery.o(.text .text.*)
    *config.o(.text .text.*)
    *handlers.o(.text .text.*)
    *main_board.o(.text .text.*)
    *mixer.o(.text .text.*)
    *power_amp.o(.text .text.*)
    *radio.o(.text .text.*)
    *rf_coupler.o(.text .text.*)
    *s_strength.o(.text .text.*)
    *scanner.o(.text .text.*)
    *settings.o(.text .text.*)
    *setup.o(.text .text.*)
    *standby.o(.text .text.*)
    *status.o(.text .text.*)
    *FIFO.o(.text .text.*)
    *FIFOv1.o(.text .text.*)
    *ShiftReg.o(.text .text.*)
    
    /* src/ subdirectories */
    *src*(.text .text.*)
    
    . = ALIGN(4);
  } >FLASH

  /* Standard text section for everything else */
  .text :
  {
    . = ALIGN(4);
    *(.text)           /* .text sections (code) */
    *(.text*)          /* .text* sections (code) */
    *(.glue_7)         /* glue arm to thumb code */
    *(.glue_7t)        /* glue thumb to arm code */
    *(.eh_frame)

    KEEP (*(.init))
    KEEP (*(.fini))

    . = ALIGN(4);
    _etext = .;        /* define a global symbols at end of code */
  } >FLASH

  /* Group read-only data by stability */
  .rodata.stable :
  {
    . = ALIGN(4);
    
    /* HAL and system constants - very stable */
    *system_stm32f4xx.o(.rodata .rodata.*)
    *FrameworkCMSISDevice*(.rodata .rodata.*)
    *FrameworkHALDriver*(.rodata .rodata.*)
    *stm32f4xx_hal*.o(.rodata .rodata.*)
    *stm32f4xx_ll*.o(.rodata .rodata.*)
    *libFrameworkCMSISDevice.a:*(.rodata .rodata.*)
    
    /* Your lib/ folder constants */
    *lib4b7*(.rodata .rodata.*)  /* InputPin */
    *lib695*(.rodata .rodata.*)  /* CDC */
    *lib9ca*(.rodata .rodata.*)  /* FatFs */
    *libaee*(.rodata .rodata.*)  /* I2CBitBang */
    *lib*(.rodata .rodata.*)     /* All other lib### folders */
    
    /* Version strings */
    *version.o(.rodata .rodata.*)
    
    . = ALIGN(4);
  } >FLASH

  .rodata.application :
  {
    . = ALIGN(4);
    
    /* Application constants and strings */
    *main.o(.rodata .rodata.*)
    *agc.o(.rodata .rodata.*)
    *battery.o(.rodata .rodata.*)
    *config.o(.rodata .rodata.*)
    *handlers.o(.rodata .rodata.*)
    *main_board.o(.rodata .rodata.*)
    *mixer.o(.rodata .rodata.*)
    *power_amp.o(.rodata .rodata.*)
    *radio.o(.rodata .rodata.*)
    *rf_coupler.o(.rodata .rodata.*)
    *s_strength.o(.rodata .rodata.*)
    *scanner.o(.rodata .rodata.*)
    *settings.o(.rodata .rodata.*)
    *setup.o(.rodata .rodata.*)
    *standby.o(.rodata .rodata.*)
    *status.o(.rodata .rodata.*)
    *FIFO.o(.rodata .rodata.*)
    *FIFOv1.o(.rodata .rodata.*)
    *ShiftReg.o(.rodata .rodata.*)
    
    /* src/ subdirectories */
    *src*(.rodata .rodata.*)
    
    . = ALIGN(4);
  } >FLASH

  /* Remaining constant data */
  .rodata :
  {
    . = ALIGN(4);
    *(.rodata)         /* .rodata sections (constants, strings, etc.) */
    *(.rodata*)        /* .rodata* sections (constants, strings, etc.) */
    . = ALIGN(4);
  } >FLASH

  .ARM.extab   : { *(.ARM.extab* .gnu.linkonce.armextab.*) } >FLASH
  .ARM : {
    __exidx_start = .;
    *(.ARM.exidx*)
    __exidx_end = .;
  } >FLASH

  .preinit_array     :
  {
    PROVIDE_HIDDEN (__preinit_array_start = .);
    KEEP (*(.preinit_array*))
    PROVIDE_HIDDEN (__preinit_array_end = .);
  } >FLASH
  .init_array :
  {
    PROVIDE_HIDDEN (__init_array_start = .);
    KEEP (*(SORT(.init_array.*)))
    KEEP (*(.init_array*))
    PROVIDE_HIDDEN (__init_array_end = .);
  } >FLASH
  .fini_array :
  {
    PROVIDE_HIDDEN (__fini_array_start = .);
    KEEP (*(SORT(.fini_array.*)))
    KEEP (*(.fini_array*))
    PROVIDE_HIDDEN (__fini_array_end = .);
  } >FLASH

  /* used by the startup to initialize data */
  _sidata = LOADADDR(.data);

  /* Initialized data sections goes into RAM, load LMA copy after code */
  .data : 
  {
    . = ALIGN(4);
    _sdata = .;        /* create a global symbol at data start */
    *(.data)           /* .data sections */
    *(.data*)          /* .data* sections */
    *(.sram)           /* .sram sections */
    *(.sram*)          /* .sram* sections */

    . = ALIGN(4);
    _edata = .;        /* define a global symbol at data end */
  } >RAM AT> FLASH

   _siccmram = LOADADDR(.ccmram);

   /* CCM-RAM section
   *
   * IMPORTANT NOTE!
   * If initialized variables will be placed in this section,
   * the startup code needs to be modified to copy the init-values.
   */
   .ccmram :
   {
        . = ALIGN(4);
        _sccmram = .;       /* create a global symbol at ccmram start */
        *(.ccmram)
        *(.ccmram*)
        *(.fccmram)         /* Another section to allow to put functions and data in this memory. If we use the same, the compiler will complain with a "section conflict error" */
        *(.fccmram*)

        . = ALIGN(4);
        _eccmram = .;       /* create a global symbol at ccmram end */
   } >CCMRAM AT> FLASH

  
  /* Uninitialized data section */
  . = ALIGN(4);
  .bss :
  {
    /* This is used by the startup in order to initialize the .bss secion */
    _sbss = .;         /* define a global symbol at bss start */
    __bss_start__ = _sbss;
    *(.bss)
    *(.bss*)
    *(COMMON)

    . = ALIGN(4);
    _ebss = .;         /* define a global symbol at bss end */
    __bss_end__ = _ebss;
  } >RAM

  /* User_heap_stack section, used to check that there is enough RAM left */
  ._user_heap_stack :
  {
    . = ALIGN(4);
    PROVIDE ( end = . );
    PROVIDE ( _end = . );
    . = . + _Min_Heap_Size;
    __heap_limit__ = .;
    . = . + _Min_Stack_Size;
    . = ALIGN(4);
  } >RAM

  /* Remove information from the standard libraries */
  /DISCARD/ :
  {
    libc.a ( * )
    libm.a ( * )
    libgcc.a ( * )
  }

  .ARM.attributes 0 : { *(.ARM.attributes) }
}
