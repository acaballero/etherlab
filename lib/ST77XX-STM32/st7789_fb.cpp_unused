#include "st7789_fb.h_unused"
#include <stdint-gcc.h>
#include <string.h>
#include <math.h>
#include "hw/stm32_hal.h"


uint16_t BACK_COLOR = 0x0000;



ST7789::ST7789(SPI_HandleTypeDef * spi_port) : ST77XX(spi_port) {


}


int16_t ST7789::begin(void) {

    this->convertPalette888to565(waterfall_palette_rgb256,waterfall_palette,16);

    select();
    //Reset();

    int16_t ret = this->initBuffer(0, 0, DISPLAY_X_PIXELS, DISPLAY_Y_PIXELS, BITS_PER_PIXEL, palette);

    if (ret >= 0) {

        ST7789_RST_Clr();

        HAL_Delay(10);
        ST7789_RST_Set();
        HAL_Delay(10);

        writeCommand(0x36);

        if (USING_HORIZONAL == 0) {
            uint8_t data[] = {0x00};
            writeData(data, sizeof(data));
        } else if (USING_HORIZONAL == 1) {
            uint8_t data[] = {0xC0};
            writeData(data, sizeof(data));
        } else if (USING_HORIZONAL == 2) {
            uint8_t data[] = {0x70};
            writeData(data, sizeof(data));
        } else {
            uint8_t data[] = {0xA0};
            writeData(data, sizeof(data));
        }


        writeCommand(0x3A);
        {
            uint8_t data[] = {0x05};
            writeData(data, sizeof(data));
        }

        writeCommand(0xB2);

        {
            uint8_t data[] = {0x0C, 0x0C, 0x00, 0x33, 0x33};

            writeData(data, sizeof(data));

        }

        writeCommand(0xB7);
        {
            uint8_t data[] = {0x35};
            writeData(data, sizeof(data));
        }

        writeCommand(0xBB);
        {
            uint8_t data[] = {0x19};
            writeData(data, sizeof(data));
        }

        writeCommand(0xC0);
        {
            uint8_t data[] = {0x2C};
            writeData(data, sizeof(data));
        }

        writeCommand(0xC2);
        {
            uint8_t data[] = {0x01};
            writeData(data, sizeof(data));
        }

        writeCommand(0xC3);
        {
            uint8_t data[] = {0x12};
            writeData(data, sizeof(data));
        }

        writeCommand(0xC4);
        {
            uint8_t data[] = {0x20};
            writeData(data, sizeof(data));
        }

        writeCommand(0xC6);
        {
            uint8_t data[] = {0x0F};
            writeData(data, sizeof(data));
        }

        writeCommand(0xD0);
        {
            uint8_t data[] = {0xA4, 0xA1};
            writeData(data, sizeof(data));
        }

        writeCommand(0xE0);
        {
            uint8_t data[] = {0xD0, 0x04, 0x0D, 0x11, 0x13, 0x2B, 0x3F, 0x54, 0x4C, 0x18, 0x0D, 0x0B, 0x1F, 0x23};
            writeData(data, sizeof(data));
        }

        writeCommand(0xE1);
        {
            uint8_t data[] = {0xD0, 0x04, 0x0C, 0x11, 0x13, 0x2C, 0x3F, 0x44, 0x51, 0x2F, 0x1F, 0x1F, 0x20, 0x23};
            writeData(data, sizeof(data));
        }

        writeCommand(0x21);
        writeCommand(0x11);
        writeCommand(0x29);

    }

    this->clear(true);
}

void ST7789::select() {
    HAL_GPIO_WritePin(ST7789_CS_PORT, ST7789_CS_PIN, GPIO_PIN_RESET);
}


void ST7789::unselect() {
    HAL_GPIO_WritePin(ST7789_CS_PORT, ST7789_CS_PIN, GPIO_PIN_SET);
}


void ST7789::reset() {
    HAL_GPIO_WritePin(ST7789_RST_PORT, ST7789_RST_PIN, GPIO_PIN_RESET);
    HAL_Delay(5);
    HAL_GPIO_WritePin(ST7789_RST_PORT, ST7789_RST_PIN, GPIO_PIN_SET);
}

void ST7789::InitDisplayDataTransfer() {
    HAL_GPIO_WritePin(ST7789_DC_PORT, ST7789_DC_PIN, GPIO_PIN_SET);
}

void ST7789::EndDisplayDataTransfer() {
    HAL_GPIO_WritePin(ST7789_DC_PORT, ST7789_DC_PIN, GPIO_PIN_RESET);
}


void ST7789::writeCommand(uint8_t cmd) {
    //select();
    HAL_GPIO_WritePin(ST7789_DC_PORT, ST7789_DC_PIN, GPIO_PIN_RESET);
    HAL_SPI_Transmit(spi_port, &cmd, sizeof(cmd), HAL_MAX_DELAY);
    //Unselect();
}


void ST7789::writeData(uint8_t *buff, size_t buff_size) {
    //select();
    HAL_GPIO_WritePin(ST7789_DC_PORT, ST7789_DC_PIN, GPIO_PIN_SET);

    // split data in small chunks because HAL can't send more then 64K at once
    while (buff_size > 0) {

        uint16_t chunk_size = buff_size > 32768 ? 32768 : buff_size;
        HAL_SPI_Transmit(spi_port, buff, chunk_size, HAL_MAX_DELAY);
        buff += chunk_size;
        buff_size -= chunk_size;
    }
    //Unselect();
}


void ST7789::setAddressWindow(uint16_t x0, uint16_t y0, uint16_t x1, uint16_t y1) {
    //select();
    if (USING_HORIZONAL == 0) {
        // column address set
        writeCommand(0x2A);
        { // CASET
            uint8_t data[] = {((x0 + 52) >> 8) & 0xFF, (x0 + 52) & 0xFF, ((x1 + 52) >> 8) & 0xFF, (x1 + 52) & 0xFF};
            writeData(data, sizeof(data));
        }
        // row address set
        writeCommand(0x2B);
        {// RASET
            uint8_t data[] = {((y0 + 40) >> 8) & 0xFF, (y0 + 40) & 0xFF, ((y1 + 40) >> 8) & 0xFF, (y1 + 40) & 0xFF};
            writeData(data, sizeof(data));
        }
        // write to RAM
        writeCommand(0x2C); // RAMWR
    } else if (USING_HORIZONAL == 1) {
        // column address set
        writeCommand(0x2A);
        { // CASET
            uint8_t data[] = {((x0 + 52) >> 8) & 0xFF, static_cast<uint8_t>((x0 + 52) & 0xFF), static_cast<uint8_t>(((x1 + 52) >> 8) & 0xFF), (x1 + 52) & 0xFF};
            writeData(data, sizeof(data));
        }
        // row address set
        writeCommand(0x2B);
        {// RASET
            uint8_t data[] = {((y0 + 40) >> 8) & 0xFF, (y0 + 40) & 0xFF, ((y1 + 40) >> 8) & 0xFF, (y1 + 40) & 0xFF};
            writeData(data, sizeof(data));
        }
        // write to RAM
        writeCommand(0x2C); // RAMWR
    } else if (USING_HORIZONAL == 2) {
        // column address set
        writeCommand(0x2A);
        { // CASET
            uint8_t data[] = {((x0 + 0) >> 8) & 0xFF, (x0 + 0) & 0xFF, ((x1 + 0) >> 8) & 0xFF, (x1 + 0) & 0xFF};
            writeData(data, sizeof(data));
        }
        // row address set
        writeCommand(0x2B);
        {// RASET
            uint8_t data[] = {((y0 + 0) >> 8) & 0xFF, (y0 + 0) & 0xFF, ((y1 + 0) >> 8) & 0xFF, (y1 + 0) & 0xFF};
            writeData(data, sizeof(data));
        }
        // write to RAM
        writeCommand(0x2C); // RAMWR
    } else {
        // column address set
        writeCommand(0x2A);
        { // CASET
            uint8_t data[] = {((x0 + 40) >> 8) & 0xFF, (x0 + 40) & 0xFF, ((x1 + 40) >> 8) & 0xFF, (x1 + 40) & 0xFF};
            writeData(data, sizeof(data));
        }
        // row address set
        writeCommand(0x2B);
        {// RASET
            uint8_t data[] = {((y0 + 52) >> 8) & 0xFF, (y0 + 52) & 0xFF, ((y1 + 52) >> 8) & 0xFF, (y1 + 52) & 0xFF};
            writeData(data, sizeof(data));
        }
        // write to RAM
        writeCommand(0x2C); // RAMWR
    }
    //Unselect();
}






